# /etc/chaarteeke/env -- the settings of the Chaar Teeke service on this box.
# systemd reads it (EnvironmentFile): one NAME=value per line, no quotes, no spaces around "=".
# It holds the keys. Mode 0600, owned by the service user. Never commit it, never paste it into a ticket.
# Made once by deploy/install.sh; the installer never overwrites it. Names are explained in .env.example.
CT_MODE=pilot
CT_TELEPHONY=ari
@@ASR_LINES@@
CT_LOCAL_TZ=Asia/Kolkata

# Where the data lives (the service may write only here and in data/prompts/audio).
CT_DB=@@STATE_DIR@@/var/chaarteeke.db
CT_VAR_DIR=@@STATE_DIR@@/var

# The app listens on loopback only. Reach it through the reverse proxy (deploy/caddy/Caddyfile).
CT_HOST=127.0.0.1
CT_PORT=8080
CT_PUBLIC_URL=@@PUBLIC_URL@@

# Keys, generated by the installer on this box. Losing CT_PHONE_KEY makes every stored number unreadable.
CT_SECRET_KEY=@@SECRET_KEY@@
CT_PHONE_KEY=@@PHONE_KEY@@

# The app's own nightly encrypted copy of the database (its key is separate from the phone key).
CT_BACKUP_DIR=@@STATE_DIR@@/var/backups-encrypted
CT_BACKUP_KEY=@@BACKUP_KEY@@

# Asterisk's REST interface, on loopback. The same password is stored hashed in /etc/asterisk/ari.conf.
CT_ARI_URL=http://127.0.0.1:8088
CT_ARI_USER=chaar
CT_ARI_PASSWORD=@@ARI_PASSWORD@@
CT_ARI_ENDPOINT=Quectel/sim7600-0/{number}

# Set by hand when you have them (remove the leading # and restart the service):
#CT_NUMBER=
#CT_CLINIC_LINES={"sim7600-0": "<clinic id>"}
#CT_BASEMAP=none
